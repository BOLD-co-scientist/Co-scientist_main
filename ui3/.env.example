# Copy to .env.local and adjust.

# Where the coscientist API server lives (used by the Vite dev proxy).
VITE_API_TARGET=http://127.0.0.1:8765

# API base path as seen by the browser. Empty = same origin (goes through the
# Vite dev proxy in dev, or your reverse proxy in prod). Brief §7.4.
VITE_API_BASE=

# Set to 1 to run entirely on bundled mock data with no backend — useful for
# design review and offline demos. Unset/0 uses the real API.
VITE_MOCK=1
