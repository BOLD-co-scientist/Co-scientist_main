# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-...

# Models. Override per role in roles/*.yaml if you want.
COSCIENTIST_MODEL_SUPERVISOR=claude-opus-4-7
COSCIENTIST_MODEL_SUBAGENT=claude-sonnet-4-6
COSCIENTIST_MODEL_EVOLUTION=claude-opus-4-7

# Set to 1 to enable the optional egress-restricted tool service. Off by default.
COSCIENTIST_ENABLE_NET=0

# Per-session iteration budget. Hard cap on supervisor turns.
COSCIENTIST_MAX_TURNS=80

# py_exec resource limits
COSCIENTIST_PYEXEC_CPU_SECONDS=60
COSCIENTIST_PYEXEC_MEM_MB=1024

# Users are created with:
#   docker compose exec coscientist-api coscientist users create alice
# The command prints a one-time API key for the Streamlit login screen.
