# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-...

# --- Deep research (R14): OpenAI Deep Research API ---
# Enables the supervisor's `deep_research` tool (mandatory once-per-session
# problem scoping + background research on request). The tool is inert without
# this key. Leave blank to disable deep research entirely.
OPENAI_API_KEY=sk-...
# Deep-research model. o4-mini-deep-research is cheaper/faster; o3-deep-research
# is the deeper (pricier) tier. NOTE: the *-deep-research models require OpenAI
# ORGANIZATION VERIFICATION (platform.openai.com/settings/organization/general);
# until verified they fail mid-run and the tool falls back to the model below.
COSCIENTIST_DEEPRESEARCH_MODEL=o4-mini-deep-research
# Fallback when the deep-research model is unavailable (e.g. org not verified):
# a web-search-grounded model that works without verification. Set empty to
# disable fallback and hard-fail instead.
COSCIENTIST_DEEPRESEARCH_FALLBACK_MODEL=o4-mini
# Max seconds the blocking `deep_research.run` polls before it hands back a
# background research_id to poll manually. Deep research is slow (minutes).
COSCIENTIST_DEEPRESEARCH_MAX_WAIT_S=1200
# Set to 1 to require human approval before every deep-research run.
COSCIENTIST_DEEPRESEARCH_HITL=0
# Optional: custom OpenAI-compatible endpoint (Azure/proxy). Usually leave blank.
OPENAI_BASE_URL=

# --- BOLD/FLAIR: non-root container identity (REQUIRED on the cluster) ---
# The image runs as a non-root user built from these (BOLD Rule 1). Set them to
# YOUR host identity so files on the shared filesystem are owned by you, not
# uid 1000. Generate with:  echo "UID=$(id -u)" >> .env; echo "GID=$(id -g)" >> .env
UID=1000
GID=1000

# --- Access (tailscale funnel serves the UI on the FLAIR node) ---
# Auth key from the tailscale admin console. Required by docker-compose.yml's
# tailscale service. If you access the node another way (e.g. an SSH tunnel),
# drop the tailscale service from the compose and publish ports directly.
TAILSCALE_AUTHKEY=tskey-auth-...

# Models. Override per role in roles/*.yaml if you want.
COSCIENTIST_MODEL_SUPERVISOR=claude-opus-4-7
COSCIENTIST_MODEL_SUBAGENT=claude-sonnet-4-6
COSCIENTIST_MODEL_EVOLUTION=claude-opus-4-7

# Set to 1 to enable the optional egress-restricted tool service. Off by default.
COSCIENTIST_ENABLE_NET=0

# Per-session iteration budget. Hard cap on supervisor turns.
COSCIENTIST_MAX_TURNS=80

# py_exec resource limits
COSCIENTIST_PYEXEC_CPU_SECONDS=60
COSCIENTIST_PYEXEC_MEM_MB=1024

# Final-deliverable format (R13). "latex" (default) → the agent writes a .tex
# report and compiles it to PDF via the latex_compile tool; "markdown" → the
# prior human-readable .md behavior. Governs deliverable files only, not chat.
COSCIENTIST_OUTPUT_FORMAT=latex
# latex_compile resource limits (only used in latex mode)
COSCIENTIST_LATEX_CPU_SECONDS=120
COSCIENTIST_LATEX_MEM_MB=2048
COSCIENTIST_LATEX_TIMEOUT_S=180

# Users are created with:
#   docker compose exec coscientist-api coscientist users create alice
# The command prints a one-time API key for the Streamlit login screen.

# ---------------------------------------------------------------------------
# R19 — guided evolution search (docs/plans/R19-guided-evolution-search.md)
# ---------------------------------------------------------------------------
# The independent judge runs on a DIFFERENT provider than the rest of the system
# (the whole harness is Claude), so its verdicts are not self-review. It reads
# this key first, then OPENAI_API_KEY, then <state>/secrets/judge_openai_key.
# Keep it separate from OPENAI_API_KEY if you do not want the tenant runtime's
# deep-research tool to share the judge's credential — the API strips this
# variable from every tenant subprocess.
COSCIENTIST_JUDGE_OPENAI_API_KEY=
# Judge model. Resolved against the account's model list, falling back through
# gpt-6 / gpt-5.x / o3 / gpt-4.1 when the configured id is not available.
COSCIENTIST_JUDGE_MODEL=gpt-6-extra
# Optional base URL for the judge (Azure / proxy). Defaults to OPENAI_BASE_URL.
COSCIENTIST_JUDGE_BASE_URL=
# How often the gate-2 watcher looks for a pending merge request, and how many
# times the judge may send an evolution back for changes before the human decides.
COSCIENTIST_JUDGE_MERGE_POLL_S=2
COSCIENTIST_JUDGE_MAX_AUTO_REJECTS=2
# Automatic mode never answers a merge that touches the gate machinery itself
# (scaffold/, evolution/, pyproject.toml, Dockerfile). Set to 1 only for a
# deliberate experiment — CLAUDE.md mandates a stricter human gate there.
COSCIENTIST_JUDGE_MAY_ANSWER_STRICT=0
# The planner: master switch, and how long it waits after a research turn so the
# R16 reflection can land and be used as evidence.
COSCIENTIST_EVO_PLAN=1
COSCIENTIST_EVO_PLAN_DELAY_S=45
# Below this confidence, a phase guess does not interrupt the researcher with a
# "has the plan changed?" question.
COSCIENTIST_DRIFT_MIN_CONFIDENCE=0.5
# Platform-scope evolutions (the agent editing the shared ui3/ + api/). OFF: the
# staging build and host-side cutover are R19 Phase 4 and are not implemented,
# so the API refuses these with 501 and the planner is told not to propose them.
COSCIENTIST_PLATFORM_EVOLUTION=0
COSCIENTIST_PLATFORM_REPO=
# Platform model calls (planner + goal derivation) go direct to the Messages API
# and fall back to the Claude Agent SDK when both direct models are refused.
# 1 = direct then SDK (default) | 0 = direct only | only = always the SDK.
COSCIENTIST_PLATFORM_SDK_FALLBACK=1
